# hh.ru требует User-Agent с контактом: название/версия (email)
HH_USER_AGENT=JobHuntAssistant/2.0 (you@example.com)
# Токен приложения hh.ru (dev.hh.ru → Мои приложения). Без него поиск вакансий отвечает 403
HH_APP_TOKEN=
# Куда сохранять выгрузку. По умолчанию ~/Documents/JobHunt
# OUTPUT_DIR=C:/Users/you/Documents/JobHunt
TOP=15
