# Скопируй в .env и заполни. .env в .gitignore — ключи не попадут в репозиторий.

# Куда сохранять выгрузку. По умолчанию ~/Documents/JobHunt
# OUTPUT_DIR=C:/Users/you/Documents/JobHunt

# Сколько вакансий в дневной выгрузке
TOP=15

# SuperJob (необязательно): ключ приложения с https://api.superjob.ru — см. README
# SUPERJOB_API_KEY=

# Резюме для писем через Claude (необязательно). По умолчанию <OUTPUT_DIR>/resume.md
# RESUME_PATH=C:/Users/you/Documents/JobHunt/resume.md
